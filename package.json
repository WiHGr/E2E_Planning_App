{
  "name": "PlanningApp",
  "version": "1.0.0",
  "description": "A simple CAP project with SAPUI5 SmartTable app.",
  "repository": "<deine-github-url-oder-leer>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.4",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": ">=8",
    "@sap/ux-specification": "^1.108.0",
    "@ui5/cli": "^4.0.26",
    "ui5-middleware-simpleproxy": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "watch": "PORT=33317 cds watch",
    "build": "ui5 build",
    "deploy": "cds deploy --to hana",
    "ui5-start": "fiori run --cwd app/sapui5-app",
    "ui5-build": "ui5 build --clean-dest --dest dist --cwd app/sapui5-app",
    "ui5-deploy": "fiori deploy --destination your-destination-name --cwd app/sapui5-app"
  },
  "sapux": [
    "app/plan-ui",
    "app/browse"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "connectivity": true,
      "destinations": true,
      "html5-runtime": true
    },
    "environment": {
      "development": {
        "requires": {
          "db": {
            "kind": "sqlite",
            "model": [
              "db",
              "srv"
            ]
          }
        }
      },
      "production": {
        "requires": {
          "auth": "xsuaa"
        }
      }
    }
  }
}
